rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Production: assign admin custom claims from a trusted server, never from the client.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /favorites/{mangaId} { allow read, write: if isOwner(uid); }
      match /readingProgress/{mangaId} { allow read, write: if isOwner(uid); }
    }
    match /mangaSubmissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120;
      allow read: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /manga/{mangaId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
      match /chapters/{chapterId} {
        allow read: if get(/databases/$(database)/documents/manga/$(mangaId)).data.status == 'published' || isAdmin();
        allow write: if isAdmin();
      }
    }
  }
}
